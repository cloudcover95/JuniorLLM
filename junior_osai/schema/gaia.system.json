{
  "$id": "junior://osai/gaia.system",
  "title": "JuniorGaia system envelope",
  "required": ["system", "ok", "who", "view", "note", "ue5_launch", "download"],
  "properties": {
    "system": {"const": "JuniorGaia"},
    "who": {"required": ["name", "pronouns"]},
    "view": {
      "properties": {
        "orient": {"enum": ["portrait", "landscape"]},
        "scale": {"minimum": 0.35, "maximum": 1.0},
        "px": {"type": "array"}
      }
    },
    "note": {
      "properties": {
        "area": {"type": "string"},
        "port": {"type": "string"},
        "gamma": {"type": "number"},
        "i2s_hex": {"type": "string"},
        "trit": {"type": "array", "items": {"enum": [-1, 0, 1]}}
      }
    },
    "identity": {
      "properties": {
        "issuer": {"const": "local-gaia.json"},
        "verified": {"type": "boolean"},
        "hardcoded_operator": {"const": false}
      }
    },
    "omega": {"properties": {"job": {"enum": ["dash-viewport", "gaia-spine", "terrain-obj", "agi-capsule"]}}},
    "ue5_launch": {"const": false},
    "download": {"const": false}
  }
}
