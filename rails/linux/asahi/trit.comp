#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { float x[]; };
layout(std430, binding = 1) writeonly buffer Out { int t[]; };
layout(push_constant) uniform P { float gamma; uint n; };
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= n) return;
  float q = round(x[i] / max(gamma, 1e-7));
  t[i] = int(clamp(q, -1.0, 1.0));
}
