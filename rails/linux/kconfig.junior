# Fragment only. Merge against a *vendor* kernel. Do not ship vmlinuz.
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
# CUDA needs the NVIDIA module on the running vendor kernel.
# MLX is not a Linux kernel option.
